{
  "name": "vendor-onboarding",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:setup": "npm run -w server db:setup",
    "db:reset": "npm run -w server db:reset --",
    "db:reencrypt": "npm run -w server db:reencrypt",
    "db:backup": "npm run -w server db:backup --",
    "db:restore": "npm run -w server db:restore --",
    "db:demo-history": "npm run -w server db:demo-history --",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run -w server dev\" \"npm run -w web dev\"",
    "build": "npm run -w server build && npm run -w web build",
    "start": "npm run -w server start",
    "test": "npm run -w server test",
    "tenant:create": "npm run -w server tenant:create --",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
