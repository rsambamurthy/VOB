# ============================================================================================
#  VendorGate on-premises settings.  Made into .env by ./scripts/gen-secrets.sh (which fills the secrets).
#  Keep .env readable by administrators only (chmod 600). Lines starting with # are notes.
# ============================================================================================

# ---- Version and size ----------------------------------------------------------------------
# The VendorGate version to run (set by the installer / upgrade script).
VG_VERSION=__VERSION__
# Copies of the application (2 recommended).
VG_APP_REPLICAS=2

# ---- Address ---------------------------------------------------------------------------------
# The address people use, e.g. vendorgate.acme.com. Put your certificate in ./certs (vendorgate.crt + vendorgate.key).
VG_HOSTNAME=vendorgate.example.com
# The same address with https:// — used in every email link.
APP_BASE_URL=https://vendorgate.example.com
# Ports on this server: staff (intranet), supplier portal (for the DMZ / WAF), and HTTP (redirects to HTTPS).
VG_STAFF_PORT=443
VG_SUPPLIER_PORT=8443
VG_HTTP_PORT=80
# Largest upload (also the app limit).
VG_MAX_UPLOAD=25m

# ---- Secrets (filled by gen-secrets.sh) ------------------------------------------------------
# Encrypts bank and tax numbers and other sensitive values. KEEP A COPY IN YOUR KEY VAULT — without it
# the encrypted data and the backups cannot be read. Never change it by hand (see the runbook: rotating the key).
ENCRYPTION_KEY=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__

# ---- First workspace (used once, on the very first start, when the database is empty) -------
BOOTSTRAP_WORKSPACE=main
BOOTSTRAP_COMPANY=Your Company Ltd
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ---- Email (required: suppliers get sign-in codes by email) ---------------------------------
# Your mail relay. EMAIL_PROVIDER=smtp
EMAIL_PROVIDER=smtp
EMAIL_FROM=VendorGate <vendorgate@example.com>
EMAIL_REPLY_TO=procurement@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---- SMS for sign-in codes (optional): test = off, msg91 or twilio (needs internet access to the provider)
SMS_PROVIDER=test
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=91

# ---- Documents -------------------------------------------------------------------------------
# local = on the vgdata volume (back it up); s3 = MinIO or another S3-compatible store; azure = Azure Blob.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_ENDPOINT=
S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# ---- Virus scanning of uploads (recommended): clamav, with the "scan" profile below ----------
SCAN_PROVIDER=clamav
# Extra containers to run: scan = ClamAV, minio = local S3 store. Comma-separated.
COMPOSE_PROFILES=scan

# ---- Verification checks (need internet access to the provider; leave as is to keep them off)
KYC_PROVIDER=mock
# SUREPASS_TOKEN=
SANCTIONS_PROVIDER=mock
# OPENSANCTIONS_API_KEY=
# WATHQ_API_KEY=

# ---- AI (optional; privacy mode — no supplier names or numbers are sent). mock = off.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=

# ---- ERP ------------------------------------------------------------------------------------
# On-prem the ERP may be on your own network (allowed by default). Connection details are set in the app.
ERP_TIMEOUT_MS=20000

# ---- Backups ----------------------------------------------------------------------------------
# Encrypted database backup every night at 02:30 (server time), keeping the newest 14. Also take
# ./scripts/backup.sh copies off this server — see the runbook.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_KEEP=14

# ---- Logs --------------------------------------------------------------------------------------
LOG_LEVEL=info
