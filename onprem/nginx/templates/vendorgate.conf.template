# VendorGate reverse proxy (rendered by the nginx image: ${VARIABLES} come from docker-compose.yml).
# Certificates: ./certs/vendorgate.crt (full chain) and ./certs/vendorgate.key

resolver 127.0.0.11 valid=10s ipv6=off;   # Docker DNS — finds every app copy, also after restarts
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server_tokens off;
client_max_body_size ${VG_MAX_UPLOAD};
proxy_read_timeout 120s;
gzip on; gzip_types text/css application/javascript application/json image/svg+xml;


# ---- HTTP → HTTPS
server {
  listen 80;
  server_name _;
  location = /api/health { set $u http://app:4000; proxy_pass $u; }
  location / { return 301 https://$host$request_uri; }
}

# ---- Staff (intranet): the whole application
server {
  listen 443 ssl;
  http2 on;
  server_name ${VG_HOSTNAME} _;
  ssl_certificate /etc/nginx/certs/vendorgate.crt;
  ssl_certificate_key /etc/nginx/certs/vendorgate.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / {
    set $u http://app:4000;
    proxy_pass $u;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
  }
}

# ---- Suppliers (published to the internet through your DMZ / WAF): the supplier portal only
server {
  listen 8443 ssl;
  http2 on;
  server_name ${VG_HOSTNAME} _;
  ssl_certificate /etc/nginx/certs/vendorgate.crt;
  ssl_certificate_key /etc/nginx/certs/vendorgate.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;

  set $u http://app:4000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Real-IP $remote_addr;

  # Supplier APIs: sign-in, the portal, applications, their documents and agreements, help.
  location ~ ^/api/(vendor|vendor-auth|apply|documents|help|health)(/|$) { proxy_pass $u; }
  location ~ ^/api/agreements/(versions|acceptances)/ { proxy_pass $u; }
  location = /api/auth/me { proxy_pass $u; }          # answers "not signed in" for the supplier pages
  location /api/ { return 404; }                      # everything else (staff, admin, ERP, SCIM) stays internal

  # Staff screens are not served here.
  location ~ ^/(staff|platform|login|signup|accept-invite|forgot-password|reset-password)(/|$) { return 404; }

  # Supplier pages and static files (the web app).
  location / { proxy_pass $u; }
}
