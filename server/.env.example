# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql://vendor:vendor@localhost:5433/vendor_onboarding
# Public URL of the web app (used in email links). In dev the Vite server runs on 5173.
APP_BASE_URL=http://localhost:5173

# --- Security ------------------------------------------------------------
# 32-byte base64 key for encrypting secrets at rest. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Development helpers: show vendor OTPs on screen and enable the Mailbox page.
# Must be false in production (the server refuses to start otherwise).
DEV_SHOW_OTP=true
# Set to true behind a proxy / load balancer (Railway, Render, nginx) so rate limits see real client IPs.
TRUST_PROXY=false

# --- Other -----------------------------------------------------------------
PORT=4000
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# ============================================================================
# Integrations — every provider defaults to TEST MODE (nothing leaves the server).
# Fill in a section and restart to go live. Admin → Integrations shows what's active.
# ============================================================================

# Background jobs (email/SMS delivery with retries, AI document reading, SLA reminders)
# run on a Postgres queue (pg-boss). false = run them in-process instead.
JOBS_ENABLED=true

# --- Email ---------------------------------------------------------------
EMAIL_PROVIDER=test                 # test | smtp | sendgrid
EMAIL_FROM="VendorGate <no-reply@yourdomain.com>"
# EMAIL_REPLY_TO=procurement@yourdomain.com
# SMTP works with Amazon SES, Microsoft 365, Google Workspace, Zoho, Mailgun, SendGrid SMTP…
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
# RESEND_API_KEY=re_...           # EMAIL_PROVIDER=resend — HTTPS API, works where SMTP is blocked (Railway Free/Hobby)

# --- SMS (vendor sign-in codes) -----------------------------------------
SMS_PROVIDER=test                   # test | msg91 | twilio
# MSG91 (India, DLT): create a DLT-approved OTP template; its variable receives the code (sent as "otp" and "var1")
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
SMS_DEFAULT_COUNTRY_CODE=91

# --- Document storage ----------------------------------------------------
STORAGE_DRIVER=local                # local | s3 | azure
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                      # Cloudflare R2 / MinIO / Wasabi; empty for AWS
# S3_FORCE_PATH_STYLE=false         # true for MinIO
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=vendor-documents
SCAN_PROVIDER=none                  # none | clamav   (docker compose --profile scan up -d clamav)
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# --- GSTIN / PAN / bank / MCA verification ------------------------------
KYC_PROVIDER=mock                   # mock | surepass
# SUREPASS_TOKEN=
# SUREPASS_BASE_URL=https://sandbox.surepass.io/api/v1     # production: https://kyc-api.surepass.io/api/v1
# Paths can be overridden if your plan uses different endpoints:
# SUREPASS_PATH_GSTIN=/corporate/gstin
# SUREPASS_PATH_PAN=/pan/pan-comprehensive
# SUREPASS_PATH_BANK=/bank-verification/
# SUREPASS_PATH_CIN=/corporate/company-details
KYC_CACHE_HOURS=24
KYC_DAILY_LIMIT=10

# --- AI document reading (also needs to be switched on per workspace) ---
AI_PROVIDER=mock                    # mock | anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5         # or claude-haiku-4-5-20251001 (cheaper)

# --- ERP push (connector, URL and credentials are set per workspace under Administration → ERP integration) ---
# ERP_ALLOW_PRIVATE_HOSTS=false      # production: allow ERP URLs on private networks (on-prem EBS over VPN)
# ERP_TIMEOUT_MS=20000

# --- Phase 6 ---
# ENCRYPTION_KEY_PREVIOUS=          # only while rotating ENCRYPTION_KEY (see DEPLOY.md)
# BACKUP_SCHEDULE=30 2 * * *        # production: nightly encrypted DB backup to storage (needs pg_dump; included in the Docker image)
# BACKUP_KEEP=14
# BOOTSTRAP_ADMIN_EMAIL=            # first deploy only: creates the first workspace and invites this admin
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_COMPANY=
# BOOTSTRAP_WORKSPACE=
